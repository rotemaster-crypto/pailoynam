rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ป้ายที่แจ้ง: ทุกคนอ่านได้ / คนที่เปิดแอป (anonymous) แจ้งได้ / แก้ได้แค่เปลี่ยนสถานะเป็น "คืนแล้ว" / ห้ามลบ
    match /plates/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['prefix','number','numberKey','province','lat','lng',
             'pickupLat','pickupLng','foundNote','pickupType','pickupPlace','contact','status','createdAt','uid','sourceUrl'])
        && (!('sourceUrl' in request.resource.data)
            || (request.resource.data.sourceUrl is string
                && request.resource.data.sourceUrl.size() <= 300
                && request.resource.data.sourceUrl.matches('^https://[^\\s]+$')))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.number is string
        && request.resource.data.number.matches('^[0-9]{1,4}$')
        && request.resource.data.numberKey == request.resource.data.number
        && request.resource.data.status == 'waiting'
        && request.resource.data.prefix is string && request.resource.data.prefix.size() <= 4
        && request.resource.data.province is string && request.resource.data.province.size() <= 40
        && request.resource.data.foundNote is string && request.resource.data.foundNote.size() <= 200
        && request.resource.data.pickupType is string && request.resource.data.pickupType.size() <= 40
        && request.resource.data.pickupPlace is string && request.resource.data.pickupPlace.size() <= 200
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 600000
        && request.resource.data.createdAt < request.time.toMillis() + 600000;
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','returnedAt'])
        && request.resource.data.status == 'returned'
        && request.resource.data.returnedAt is int;
      allow delete: if false;
    }

    // ประกาศป้ายหาย: ทุกคนอ่านได้ (คนเจอค้นเลขแล้วติดต่อเจ้าของได้) / เจ้าของ (uid เดิม) ปิดประกาศได้อย่างเดียว / ห้ามลบ
    match /lost/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['prefix','number','numberKey','province','area','contact','status','createdAt','uid'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.number is string
        && request.resource.data.number.matches('^[0-9]{1,4}$')
        && request.resource.data.numberKey == request.resource.data.number
        && request.resource.data.status == 'looking'
        && request.resource.data.prefix is string && request.resource.data.prefix.size() <= 4
        && request.resource.data.province is string && request.resource.data.province.size() <= 40
        && request.resource.data.area is string && request.resource.data.area.size() <= 120
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 80
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 600000
        && request.resource.data.createdAt < request.time.toMillis() + 600000;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'looking'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt'])
        && request.resource.data.status == 'closed'
        && request.resource.data.closedAt is int;
      allow delete: if false;
    }

    // ขอรับแจ้งเตือน: id = "<เลข>_<token>" / ห้ามอ่าน (token เป็นความลับ) / Cloud Function อ่านด้วยสิทธิ์ admin
    match /subs/{id} {
      allow read: if false;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['token','numberKey','createdAt'])
        && request.resource.data.numberKey is string
        && request.resource.data.numberKey.matches('^[0-9]{1,4}$')
        && request.resource.data.token is string
        && request.resource.data.token.size() > 20 && request.resource.data.token.size() < 400
        && id == request.resource.data.numberKey + '_' + request.resource.data.token
        && request.resource.data.createdAt is int;
      allow delete: if request.auth != null;
    }

    // รูปป้าย (ย่อแล้ว เก็บเป็นข้อความ ไม่ต้องใช้ Storage)
    match /photos/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['dataUrl'])
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.dataUrl.size() < 400000;
      allow update, delete: if false;
    }
  }
}
